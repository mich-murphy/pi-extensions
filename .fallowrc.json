{
  "$schema": "./node_modules/fallow/schema.json",
  "minimumVersion": "3.32.0",
  // Real Pi subprocess/evaluation entrypoints are launched outside the TS import graph.
  "framework": [
    {
      // Run by the gateway-release consumer job via `node --import jiti/register`.
      "name": "gateway-nix-consumer-ci",
      "enablers": ["jiti"],
      "entryPoints": ["scripts/verify-gateway-nix.ts"],
      "entryPointRole": "support"
    },
    {
      // Run by the gateway-release consumer job via `node --import jiti/register`.
      "name": "gateway-public-native-consumer-ci",
      "enablers": ["jiti"],
      "entryPoints": ["scripts/verify-gateway-native.ts"],
      "entryPointRole": "support"
    },
    // Bombadil loads a specification and reads every export as a property or action generator.
    {
      "name": "bombadil-terminal-specifications",
      "enablers": ["@antithesishq/bombadil"],
      "entryPoints": ["packages/*/test/bombadil/*.ts", "scripts/bombadil-pi.ts"],
      "entryPointRole": "test"
    }
  ],
  "rules": {
    "unused-dev-dependencies": "error",
    "unused-optional-dependencies": "error",
    "type-only-dependencies": "error",
    "test-only-dependencies": "error",
    "dev-dependencies-in-production": "error",
    "re-export-cycle": "error",
    "stale-suppressions": "error",
    "require-suppression-reason": "error",
    "private-type-leaks": "error"
  },
  // A stray export from a package entry is dead too: Pi reads only the default export
  "includeEntryExports": true,
  // Bombadil reads every export of a specification by name, so none has a static consumer.
  "ignoreExports": [
    // Bombadil reads every export of a specification; Pi and the launcher read the default export
    // of test-only extensions and fixtures.
    { "file": "packages/*/test/bombadil/*.ts", "exports": ["*"] }
  ],
  "failOnParseError": true,
  "usedClassMembers": [{ "extends": "Error", "members": ["_tag"] }],
  "typeAware": {
    "enabled": true,
    "projects": ["tsconfig.json"],
    "require": "best-effort"
  },
  // The pi-scrollback journey drives the system tmux and skips without it off CI.
  "ignoreBinaries": ["tmux"],
  "health": {
    "coverage": "coverage/coverage-final.json"
  },
  // Every operator, opt-in ones included: the default set misses changes such as `every` to `some`.
  "mutation": {
    "runner": "vitest",
    "operators": [
      "arithmetic-operator",
      "relational-operator",
      "logical-operator",
      "negate-condition",
      "unary-operator",
      "update-operator",
      "removed-call",
      "return-value",
      "boolean-literal",
      "string-literal",
      "optional-chaining",
      "regex-literal",
      "removed-chain-link",
      "block-statement",
      "array-literal",
      "object-literal",
      "method-expression",
      "switch-case",
      "call-expression",
      "throw-statement",
      "regex-constructor",
      "regex-assertion",
      "nullish-fallback"
    ]
  },
  "duplicates": {
    "mode": "strict",
    "minOccurrences": 3
  }
}
