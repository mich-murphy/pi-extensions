{
  "$schema": "./node_modules/fallow/schema.json",
  "minimumVersion": "3.32.0",
  // Real Pi subprocess/evaluation entrypoints are launched outside the TS import graph.
  "framework": [
    {
      "name": "session-communication-offline-pi",
      "enablers": ["@earendil-works/pi-coding-agent"],
      "entryPoints": [
        "packages/pi-session-communication/test/spike/extension.ts",
        "packages/pi-session-communication/test/spike/production-extension.ts",
        "packages/pi-session-communication/test/codemode/serve.ts",
        "packages/pi-session-communication/test/codemode/trial.ts",
        "packages/pi-session-communication/test/codemode/run.ts"
      ],
      "entryPointRole": "test",
      "usedExports": [
        {
          "pattern": "packages/pi-session-communication/test/spike/extension.ts",
          "exports": ["default"]
        },
        {
          "pattern": "packages/pi-session-communication/test/spike/production-extension.ts",
          "exports": ["default"]
        }
      ]
    }
  ],
  "rules": {
    "unused-dev-dependencies": "error",
    "unused-optional-dependencies": "error",
    "type-only-dependencies": "error",
    "test-only-dependencies": "error",
    "dev-dependencies-in-production": "error",
    "re-export-cycle": "error",
    "stale-suppressions": "error",
    "require-suppression-reason": "error",
    "private-type-leaks": "error"
  },
  // A stray export from a package entry is dead too: Pi reads only the default export
  "includeEntryExports": true,
  "failOnParseError": true,
  "usedClassMembers": [{ "extends": "Error", "members": ["_tag"] }],
  "typeAware": {
    "enabled": true,
    "projects": ["tsconfig.json"],
    "require": "best-effort"
  },
  "health": {
    "coverage": "coverage/coverage-final.json"
  },
  "duplicates": {
    "mode": "strict",
    "minOccurrences": 3
  }
}
