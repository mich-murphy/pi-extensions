{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": ["packages/*/index.ts", "packages/*/test/**/*.test.ts", "vitest.config.ts"],
  "rules": {
    "unused-files": "error",
    "unused-exports": "warn",
    "unresolved-imports": "error",
    "coverage-gaps": "warn"
  },
  "audit": {
    "gate": "new-only"
  },
  "typeAware": {
    "enabled": true,
    "projects": ["tsconfig.json"],
    "require": "best-effort"
  }
}
