{
  "name": "pi-extensions",
  "version": "0.1.2",
  "private": true,
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "format": "oxfmt --threads=2",
    "lint": "oxlint --threads=2",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:properties": "vitest run --config vitest.properties.config.ts",
    "test:properties:rust": "cd packages/pi-comms/gateway && export CARGO_BUILD_JOBS=2 HEGEL_SEED=\"${HEGEL_SEED:-$(od -An -N8 -tu8 /dev/urandom | tr -d ' ')}\" HEGEL_TEST_CASES=\"${HEGEL_TEST_CASES:-2000}\" && echo \"Hegel properties: HEGEL_SEED=$HEGEL_SEED HEGEL_TEST_CASES=$HEGEL_TEST_CASES\" && cargo test --locked --all-features $(grep -l hegel::test tests/*.rs | sed 's|tests/\\(.*\\)\\.rs|--test \\1|') -- --test-threads=2",
    "bench:skill-toggle-cache": "vitest run packages/pi-skill-toggle/test/cache-benchmark.test.ts",
    "test:claude-sdk-pin": "vitest run packages/pi-claude-sdk/test/sdk-release-contract.test.ts",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:claude-sdk-upgrade": "npm run test:live && npm run test:claude-sdk-pin",
    "fallow:audit": "fallow audit --gate new-only --coverage coverage/coverage-final.json",
    "fallow:review": "fallow audit --brief --coverage coverage/coverage-final.json",
    "fallow:dead-code": "fallow dead-code",
    "fallow:production": "fallow dead-code --production",
    "fallow:health": "fallow health --coverage coverage/coverage-final.json",
    "fallow:dupes": "fallow dupes --fail-on-issues",
    "fallow": "npm run fallow:dead-code && npm run fallow:dupes && npm run fallow:health",
    "markdownlint": "markdownlint-cli2 --config config/markdownlint-cli2.yaml \"**/*.md\" \"#node_modules\"",
    "check:rust": "cd packages/pi-comms/gateway && export CARGO_BUILD_JOBS=2 RUST_TEST_THREADS=2 && cargo fmt --all -- --check && cargo check --locked --all-targets --all-features && cargo clippy --locked --all-targets --all-features -- -D warnings && cargo test --locked --all-features -- --test-threads=2 && RUSTDOCFLAGS='-D warnings' cargo doc --locked --all-features --no-deps",
    "check": "oxfmt --check --threads=2 && oxlint --threads=2 && npm run typecheck && npm run check:rust && npm run test:coverage && npm run fallow && npm run markdownlint"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-tui": "1.5.0",
    "@effect/vitest": "4.1.2",
    "@hegeldev/hegel": "0.5.1",
    "@types/node": "26.6.6",
    "@types/turndown": "5.0.6",
    "@vitest/coverage-v8": "5.0.5",
    "fallow": "3.39.0",
    "markdownlint-cli2": "0.24.0",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@anthropic-ai/claude-agent-sdk-darwin-arm64": "file:./packages/pi-claude-sdk/vendor/no-bundled-claude",
    "@anthropic-ai/claude-agent-sdk-darwin-x64": "file:./packages/pi-claude-sdk/vendor/no-bundled-claude",
    "@anthropic-ai/claude-agent-sdk-linux-arm64": "file:./packages/pi-claude-sdk/vendor/no-bundled-claude",
    "@anthropic-ai/claude-agent-sdk-linux-arm64-musl": "file:./packages/pi-claude-sdk/vendor/no-bundled-claude",
    "@anthropic-ai/claude-agent-sdk-linux-x64": "file:./packages/pi-claude-sdk/vendor/no-bundled-claude",
    "@anthropic-ai/claude-agent-sdk-linux-x64-musl": "file:./packages/pi-claude-sdk/vendor/no-bundled-claude",
    "@anthropic-ai/claude-agent-sdk-win32-arm64": "file:./packages/pi-claude-sdk/vendor/no-bundled-claude",
    "@anthropic-ai/claude-agent-sdk-win32-x64": "file:./packages/pi-claude-sdk/vendor/no-bundled-claude",
    "katex": "0.19.1",
    "smol-toml": "1.9.1",
    "undici": "8.12.3"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "@google/genai": false,
    "fsevents": false,
    "koffi": false,
    "protobufjs": false
  },
  "pi": {
    "extensions": [
      "./packages/pi-claude-sdk/index.ts",
      "./packages/pi-auto-resume/index.ts",
      "./packages/pi-caffeinate/index.ts",
      "./packages/pi-skill-toggle/index.ts",
      "./packages/pi-vim/index.ts",
      "./packages/pi-scroll-context/index.ts",
      "./packages/pi-web-tools/index.ts",
      "./packages/pi-comms/index.ts"
    ]
  }
}
