{
  "name": "pi-extensions",
  "version": "0.1.0",
  "private": true,
  "keywords": [
    "pi-package"
  ],
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "format": "oxfmt",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:claude-sdk-pin": "vitest run packages/claude-sdk-provider/test/sdk-release-contract.test.ts",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:claude-sdk-upgrade": "npm run test:live && npm run test:claude-sdk-pin",
    "fallow:audit": "fallow audit --gate new-only --coverage coverage/coverage-final.json",
    "fallow:review": "fallow audit --brief --coverage coverage/coverage-final.json",
    "fallow:dead-code": "fallow dead-code",
    "fallow:production": "fallow dead-code --production",
    "fallow:health": "fallow health --coverage coverage/coverage-final.json",
    "fallow:dupes": "fallow dupes --fail-on-issues",
    "fallow": "npm run fallow:dead-code && npm run fallow:dupes && npm run fallow:health",
    "markdownlint": "markdownlint-cli2 --config config/markdownlint-cli2.yaml \"**/*.md\" \"#node_modules\"",
    "check": "oxfmt --check && oxlint && npm run typecheck && npm run test:coverage && npm run fallow && npm run markdownlint"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@earendil-works/pi-tui": "1.1.0",
    "@effect/vitest": "4.0.3",
    "@types/node": "24.19.2",
    "@types/turndown": "5.0.6",
    "@vitest/coverage-v8": "5.0.4",
    "fallow": "3.33.1",
    "markdownlint-cli2": "0.23.3",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2004",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  },
  "overrides": {
    "katex": "0.19.0",
    "smol-toml": "1.9.1"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "@google/genai": false,
    "fsevents": false,
    "protobufjs": false
  },
  "pi": {
    "extensions": [
      "./packages/claude-sdk-provider/index.ts",
      "./packages/no-sleep/index.ts",
      "./packages/pi-skill-toggle/index.ts",
      "./packages/pi-vim/index.ts",
      "./packages/pi-web-tools/index.ts"
    ]
  }
}
